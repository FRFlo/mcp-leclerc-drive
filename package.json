{
  "name": "mcp-leclerc-drive",
  "version": "0.3.1",
  "mcpName": "io.github.FRFlo/leclerc-drive",
  "description": "MCP server for E.Leclerc Drive — search products, manage cart, and order groceries from Claude",
  "type": "module",
  "bin": {
    "mcp-leclerc-drive": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "bun dist/index.js",
    "inspect": "bunx @modelcontextprotocol/inspector bun dist/index.js",
    "smoke": "node scripts/smoke-test.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "leclerc",
    "leclerc-drive",
    "grocery",
    "courses"
  ],
  "author": "skunkobi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FRFlo/mcp-leclerc-drive.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/bun": "^1.3.6",
    "typescript": "^7.0.2"
  }
}
